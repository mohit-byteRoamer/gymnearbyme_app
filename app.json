{
  "expo": {
    "name": "GymApp",
    "slug": "gymapp",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "gymapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymapp.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GymApp needs your location to find gyms near you in Ludhiana."
      }
    },
    "android": {
      "package": "com.gymapp.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gymapp",
              "host": "gym"
            },
            {
              "scheme": "https",
              "host": "gymapp.in",
              "pathPrefix": "/gym"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
